{
	"compilerOptions": {
		"strict": true,
		"target": "es2022",
		"module": "node16",
		"lib": [
			"es2022"
		],
		"declaration": false,
		"declarationMap": false,
		"sourceMap": true,
		"moduleResolution": "node16",
		"outDir": "./dist",
		"rootDir": ".",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": [
			"node"
		]
	},
	"include": [
		"credentials/**/*.ts",
		"nodes/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
