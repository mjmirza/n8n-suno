{
	"name": "n8n-nodes-suno",
	"version": "1.7.2",
	"description": "n8n community node for the Suno AI Music Generation API — generate music, lyrics, audio processing, and more",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"suno",
		"ai",
		"music",
		"generation",
		"audio",
		"lyrics"
	],
	"license": "MIT",
	"author": {
		"name": "Mirza Iqbal",
		"email": "support@next8n.com",
		"url": "https://next8n.com"
	},
	"homepage": "https://next8n.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mjmirza/n8n-suno.git",
		"directory": "n8n-nodes-suno"
	},
	"bugs": {
		"url": "https://github.com/mjmirza/n8n-suno/issues"
	},
	"main": "dist/nodes/Suno/Suno.node.js",
	"files": [
		"dist",
		"LICENSE"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/SunoApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Suno/Suno.node.js"
		]
	},
	"scripts": {
		"build": "tsc && node scripts/copy-icons.mjs",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint .",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"prepublishOnly": "npm run build",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@n8n/eslint-plugin-community-nodes": "0.38.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.0.0",
		"@typescript-eslint/parser": "^8.72.1",
		"eslint": "9.29.0",
		"eslint-plugin-n8n-nodes-base": "^2.0.0",
		"jest": "^30.5.2",
		"n8n-workflow": "^2.16.0",
		"prettier": "^3.9.10",
		"ts-jest": "^29.4.15",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
